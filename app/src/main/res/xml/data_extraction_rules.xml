<?xml version="1.0" encoding="utf-8"?>
<!-- Cloud backups and device transfers on Android 12 and higher. Encrypted API keys stay out (IRON-36). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="api_keys.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="api_keys.xml" />
    </device-transfer>
</data-extraction-rules>
